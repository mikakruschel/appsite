---
import ChangelogEntry from "@/components/changelog/ChangelogEntry.astro";
import RssSubscribeLink from "@/components/common/RssSubscribeLink.astro";
import Layout from "@/layouts/Layout.astro";
import { getChangelogReleases } from "@/lib/collections";
import { formatPageTitle } from "@/lib/page-title";
import { site } from "@/site.config";
import { changelogRssFeed } from "@/lib/rss";
import { render } from "astro:content";

const releases = await getChangelogReleases();

const entries = await Promise.all(
  releases.map(async (release) => {
    const { Content } = await render(release);
    return { release, Content };
  }),
);
---

<Layout
  title={formatPageTitle("Changelog")}
  description={`Release notes and version history for ${site.name}.`}
  feeds={[changelogRssFeed]}
>
  <main class="xs:py-20 mx-auto w-full max-w-3xl px-5 py-7">
    <header class="mb-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1
            class="text-3xl leading-tight font-semibold text-balance sm:text-4xl"
          >
            Changelog
          </h1>
          <p
            class="text-label-secondary mt-2 text-lg leading-relaxed text-pretty"
          >
            Discover the latest releases in {site.name}.
          </p>
        </div>
        <RssSubscribeLink feed={changelogRssFeed} />
      </div>
    </header>

    {
      entries.length > 0 ? (
        <div>
          {entries.map(({ release, Content }) => (
            <ChangelogEntry release={release} Content={Content} />
          ))}
        </div>
      ) : (
        <p class="text-label-secondary">No releases yet. Check back soon.</p>
      )
    }
  </main>
</Layout>
