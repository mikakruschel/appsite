---
import type { LucideIcon } from "lucide-react";
import { cn } from "@/lib/utils";

interface Props {
  title: string;
  description: string;
  icon: LucideIcon;
  iconClass?: string;
}

const { title, description, icon: Icon, iconClass } = Astro.props;
---

<div class="flex flex-col items-center text-center">
  <div
    class="bg-card ring-label/5 dark:ring-label/10 mb-4 flex size-12 items-center justify-center rounded-[14px] ring-1"
  >
    <Icon
      className={cn("text-accent size-6 shrink-0", iconClass)}
      strokeWidth={1.75}
    />
  </div>
  <h3 class="text-base leading-tight font-bold tracking-tight">
    {title}
  </h3>
  <p
    class="text-label-secondary mt-1.5 max-w-[14rem] text-sm leading-tight text-balance"
  >
    {description}
  </p>
</div>
