---
import FeatureIconCard from "@/components/cards/FeatureIconCard.astro";
import Section from "@/components/sections/Section.astro";
import type { LucideIcon } from "lucide-react";

export type FeatureIconItem = {
  title: string;
  description: string;
  icon: LucideIcon;
  iconClass?: string;
};

interface Props {
  title?: string;
  items: FeatureIconItem[];
}

const { title, items } = Astro.props;
---

<Section title={title}>
  <div
    class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 sm:gap-x-8 lg:gap-y-12"
  >
    {
      items.map((item) => (
        <FeatureIconCard
          title={item.title}
          description={item.description}
          icon={item.icon}
          iconClass={item.iconClass}
        />
      ))
    }
  </div>
</Section>
