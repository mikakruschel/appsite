{
  "name": "app-landing-page",
  "type": "module",
  "version": "0.0.1",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate:theme && astro build",
    "preview": "astro preview",
    "check": "pnpm validate:theme && astro check",
    "check:contrast": "node --experimental-strip-types scripts/contrast.ts",
    "validate:site-content": "node --experimental-strip-types scripts/site-content.ts",
    "validate:theme": "node --experimental-strip-types scripts/theme/check.ts",
    "test:tooling": "node --experimental-strip-types --test scripts/*.test.ts scripts/appstore/*.test.ts scripts/site-content/*.test.ts scripts/theme/*.test.ts",
    "test:site-content": "node --experimental-strip-types --test scripts/site-content/*.test.ts",
    "format": "prettier --write .",
    "fetch:appstore-metadata": "node --experimental-strip-types scripts/appstore/scrape.ts",
    "fetch:appstore-changelog": "node --experimental-strip-types scripts/appstore/changelog.ts",
    "import:appstore-changelog": "node --experimental-strip-types scripts/appstore/changelog.ts import",
    "fetch:appstore-reviews": "node --experimental-strip-types scripts/appstore/reviews.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.0",
    "sharp": "^0.35.3",
    "simple-icons-astro": "^16.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^1.8.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.1.2",
    "apca-w3": "0.1.9",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "yaml": "2.9.0"
  }
